    {
      "id": "D01",
      "type": "speech",
      "speaker": "若叶墨",
      "text": "我们已经有一个 while (true) 了……\n为什么真实系统还要拆成外层和内层？",
      "direction": "horizontal",
      "x": 236,
      "y": 244,
      "width": 940,
      "height": 142,
