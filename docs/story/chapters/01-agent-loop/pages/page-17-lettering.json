      "align": "center",
      "appearance": "inverted"
    },
    {
      "id": "R01",
      "type": "technical",
      "speaker": null,
      "text": "更便宜\n已有折叠够用时\n不额外调用模型制作摘要",
      "direction": "horizontal",
      "x": 64,
      "y": 1246,
      "width": 348,
