    {
      "id": "D01",
      "type": "speech",
      "speaker": "丰川祥子",
      "text": "墨，今天的资料\n送来了。",
      "direction": "vertical",
      "x": 45,
      "y": 72,
      "width": 101,
      "height": 205,
      "padding": 10,
      "fontFamily": "PingFang SC",
      "fontSize": 22,
      "minFontSize": 15,
      "fontWeight": 500,
      "lineHeight": 1.2,
      "align": "center"
    },
    {
      "id": "N01",
      "type": "narration",
      "speaker": null,
      "text": "丰川祥子，十三岁。\n墨的青梅竹马。\n每天送来学校资料。",
      "direction": "vertical",
      "x": 726,
      "y": 40,
      "width": 101,
      "height": 180,
      "padding": 8,
      "fontFamily": "PingFang SC",
      "fontSize": 17,
      "minFontSize": 12,
      "fontWeight": 600,
      "lineHeight": 1.15,
      "align": "center"
    },
    {
      "id": "D02",
      "type": "speech",
      "speaker": "丰川祥子",
      "text": "语言模型只能生成回答，当然无法直接干涉现实。",
      "direction": "vertical",
      "x": 32,
      "y": 490,
      "width": 110,
      "height": 205,
      "padding": 10,
      "fontFamily": "PingFang SC",
      "fontSize": 19,
      "minFontSize": 14,
      "fontWeight": 500,
      "lineHeight": 1.18,
      "align": "center"
    },
    {
      "id": "D03",
      "type": "speech",
      "speaker": "丰川祥子",
      "text": "它缺少的是连接语言与现实的媒介——\n能够执行命令的契约之手。",
      "direction": "vertical",
      "x": 603,
      "y": 746,
      "width": 196,
      "height": 349,
      "padding": 16,
      "fontFamily": "PingFang SC",
      "fontSize": 24,
      "minFontSize": 16,
      "fontWeight": 600,
      "lineHeight": 1.25,
      "align": "center"
    },
    {
      "id": "D04",
      "type": "speech",
      "speaker": "若叶墨",
      "text": "祥子，\n讲人话。",
      "direction": "vertical",
      "x": 37,
      "y": 1146,
      "width": 94,
      "height": 151,
      "padding": 9,
      "fontFamily": "PingFang SC",
      "fontSize": 22,
      "minFontSize": 15,
      "fontWeight": 500,
      "lineHeight": 1.2,
      "align": "center"
    },
    {
      "id": "D05",
      "type": "speech",
      "speaker": "丰川祥子",
      "text": "给它工具。",
      "direction": "vertical",
      "x": 736,
      "y": 1148,
      "width": 82,
      "height": 149,
      "padding": 9,
      "fontFamily": "PingFang SC",
      "fontSize": 22,
      "minFontSize": 15,
      "fontWeight": 600,
      "lineHeight": 1.2,
      "align": "center"
    },
    {
      "id": "D06",
      "type": "speech",
      "speaker": "若叶墨",
      "text": "哦！",
      "direction": "vertical",
      "x": 37,
      "y": 1344,
      "width": 80,
      "height": 146,
      "padding": 9,
      "fontFamily": "PingFang SC",
      "fontSize": 29,
      "minFontSize": 18,
      "fontWeight": 600,
      "lineHeight": 1.2,
      "align": "center"
    },
    {
      "id": "D07",
      "type": "speech",
      "speaker": "丰川祥子",
      "text": "我怎么会有这种青梅竹马……",
      "direction": "vertical",
      "x": 726,
      "y": 1332,
      "width": 74,
      "height": 147,
      "padding": 6,
      "fontFamily": "PingFang SC",
      "fontSize": 17,
      "minFontSize": 14,
      "fontWeight": 500,
      "lineHeight": 1.1,
      "align": "center"
    },
    {
      "id": "D08",
      "type": "speech",
      "speaker": "森美奈美",
      "text": "因为祥子最喜欢\n墨墨嘛。",
      "direction": "vertical",
      "x": 18,
      "y": 1514,
      "width": 105,
      "height": 246,
      "padding": 10,
      "fontFamily": "PingFang SC",
      "fontSize": 22,
      "minFontSize": 14,
      "fontWeight": 500,
      "lineHeight": 1.2,
      "align": "center"
    },
    {
      "id": "D09",
      "type": "speech",
      "speaker": "若叶墨",
      "text": "欸……？",
      "direction": "vertical",
      "x": 425,
      "y": 1521,
      "width": 69,
      "height": 161,
      "padding": 8,
      "fontFamily": "PingFang SC",
      "fontSize": 21,
      "minFontSize": 15,
      "fontWeight": 500,
      "lineHeight": 1.2,
      "align": "center"
    },
    {
      "id": "D10",
      "type": "speech",
      "speaker": "丰川祥子",
      "text": "请、请不要擅自\n得出结论！",
      "direction": "vertical",
      "x": 729,
      "y": 1518,
      "width": 92,
      "height": 244,
      "padding": 10,
      "fontFamily": "PingFang SC",
      "fontSize": 20,
      "minFontSize": 14,
      "fontWeight": 600,
      "lineHeight": 1.2,
      "align": "center"
    }
  ]
