      "lineHeight": 1.15,
      "align": "center",
      "appearance": "label"
    },
    {
      "id": "C01",
      "type": "technical",
      "speaker": null,
      "text": "if (toolUses.length > 0) {\n  continue;\n}\n\nbreak;",
      "direction": "horizontal",
      "x": 64,
      "y": 454,
      "width": 534,
      "height": 150,
      "padding": 16,
      "fontFamily": "SFMono-Regular",
      "fontSize": 19,
      "minFontSize": 16,
      "fontWeight": 550,
      "lineHeight": 1.22,
      "align": "left",
      "appearance": "tone-light"
    },
    {
      "id": "C02",
      "type": "technical",
      "speaker": null,
      "text": "const decision = inspectOutcome(response);\nif (decision.kind === \"done\") break;\n\nprepareNextAttempt(decision.reason);\ncontinue;",
      "direction": "horizontal",
      "x": 642,
      "y": 454,
      "width": 534,
      "height": 150,
      "padding": 20,
      "fontFamily": "SFMono-Regular",
      "fontSize": 17,
      "minFontSize": 16,
      "fontWeight": 550,
      "lineHeight": 1.16,
      "align": "left",
      "appearance": "tone-light"
    },
    {
      "id": "N01",
      "type": "narration",
      "speaker": null,
      "text": "有 tool_use 就继续；否则结束。",
      "direction": "horizontal",
      "x": 64,
      "y": 612,
      "width": 534,
      "height": 58,
      "padding": 12,
      "fontFamily": "PingFang SC",
      "fontSize": 19,
      "minFontSize": 16,
      "fontWeight": 600,
      "lineHeight": 1.2,
      "align": "center",
      "appearance": "card"
    },
    {
      "id": "N02",
      "type": "narration",
      "speaker": null,
      "text": "识别原因，准备下一轮，再 continue。",
      "direction": "horizontal",
      "x": 642,
      "y": 612,
      "width": 534,
      "height": 58,
      "padding": 12,
      "fontFamily": "PingFang SC",
      "fontSize": 19,
      "minFontSize": 16,
      "fontWeight": 600,
      "lineHeight": 1.2,
      "align": "center",
      "appearance": "card"
    },
    {
      "id": "M01",
      "type": "narration",
      "speaker": null,
      "text": "七种继续原因，分成四组",
      "direction": "horizontal",
      "x": 64,
      "y": 694,
      "width": 1112,
      "height": 54,
      "padding": 10,
