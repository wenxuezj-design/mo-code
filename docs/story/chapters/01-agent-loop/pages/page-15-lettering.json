    {
      "id": "W00",
      "type": "narration",
      "speaker": null,
      "text": "是谁要求继续？",
      "direction": "horizontal",
      "x": 64,
      "y": 1148,
      "width": 1112,
      "height": 50,
      "padding": 8,
      "fontFamily": "PingFang SC",
      "fontSize": 23,
      "minFontSize": 19,
      "fontWeight": 700,
      "lineHeight": 1.15,
      "align": "center",
      "appearance": "inverted"
    },
    {
      "id": "W01",
      "type": "technical",
      "speaker": null,
      "text": "模型要求继续\n\n需要工具取得信息\n或执行行动",
      "direction": "horizontal",
      "x": 64,
      "y": 1214,
      "width": 348,
      "height": 116,
      "padding": 16,
      "fontFamily": "PingFang SC",
      "fontSize": 18,
      "minFontSize": 15,
      "fontWeight": 650,
      "lineHeight": 1.16,
      "align": "center",
      "appearance": "card"
    },
    {
      "id": "W02",
      "type": "technical",
      "speaker": null,
      "text": "运行时要求继续\n\n恢复上下文过长\n或输出截断",
      "direction": "horizontal",
      "x": 446,
      "y": 1214,
      "width": 348,
      "height": 116,
      "padding": 16,
      "fontFamily": "PingFang SC",
      "fontSize": 18,
      "minFontSize": 15,
      "fontWeight": 650,
      "lineHeight": 1.16,
      "align": "center",
      "appearance": "tone-light"
    },
    {
      "id": "W03",
      "type": "technical",
      "speaker": null,
      "text": "系统策略要求继续\n\n验收尚未通过，或\n一次预算暂时用完",
      "direction": "horizontal",
      "x": 828,
      "y": 1214,
      "width": 348,
      "height": 116,
      "padding": 16,
      "fontFamily": "PingFang SC",
      "fontSize": 18,
      "minFontSize": 15,
