      "lineHeight": 1.2,
      "align": "center",
      "appearance": "inverted"
    },
    {
      "id": "G01H",
      "type": "technical",
      "speaker": null,
      "text": "① 正常行动 · 一种原因",
      "direction": "horizontal",
      "x": 64,
      "y": 764,
      "width": 534,
      "height": 40,
      "padding": 8,
