      "appearance": "card"
    },
    {
      "id": "G01A",
      "type": "technical",
      "speaker": null,
      "text": "A · next_turn\n模型调用工具 → 执行工具\n把结果送回消息 → 进入下一轮",
      "direction": "horizontal",
      "x": 64,
      "y": 812,
      "width": 534,
