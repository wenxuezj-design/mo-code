    },
    {
      "id": "S02",
      "type": "technical",
      "speaker": null,
      "text": "生产级 · 先判断是否真正终结",
      "direction": "horizontal",
      "x": 642,
      "y": 400,
      "width": 534,
      "height": 46,
      "padding": 10,
