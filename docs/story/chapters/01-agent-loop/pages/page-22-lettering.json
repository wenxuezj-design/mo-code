    {
      "id": "C01",
      "type": "technical",
      "speaker": null,
      "text": "教学伪代码：按 tool_use.id 复用提前任务\nconst early = new Map();\nonToolBlockComplete(block => {\n  if (validate(block) && concurrencySafe(block) &&\n      permission(block) === \"allow\") {\n    early.set(block.id, executeTool(block));\n  }\n});\nconst result = early.has(toolUse.id)\n  ? await early.get(toolUse.id)\n  : await executeTool(toolUse);",
