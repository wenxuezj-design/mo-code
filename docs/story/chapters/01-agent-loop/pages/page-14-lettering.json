    },
    {
      "id": "S01",
      "type": "technical",
      "speaker": null,
      "text": "生产端 · async function*",
      "direction": "horizontal",
      "x": 64,
      "y": 400,
      "width": 534,
      "height": 46,
      "padding": 10,
      "fontFamily": "SFMono-Regular",
