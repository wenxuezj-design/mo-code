      "align": "center",
      "appearance": "label"
    },
    {
      "id": "C01",
      "type": "technical",
      "speaker": null,
      "text": "async function* queryLoop() {\n  yield textEvent;\n  yield toolEvent;\n  yield finalEvent;\n}",
      "direction": "horizontal",
      "x": 64,
      "y": 454,
      "width": 534,
      "height": 176,
      "padding": 22,
      "fontFamily": "SFMono-Regular",
      "fontSize": 20,
      "minFontSize": 16,
      "fontWeight": 550,
      "lineHeight": 1.28,
      "align": "left",
      "appearance": "code"
    },
    {
      "id": "C02",
      "type": "technical",
      "speaker": null,
      "text": "for await (const event of queryLoop()) {\n  await render(event);\n}",
      "direction": "horizontal",
      "x": 642,
      "y": 454,
      "width": 534,
      "height": 176,
      "padding": 22,
      "fontFamily": "SFMono-Regular",
      "fontSize": 20,
      "minFontSize": 16,
      "fontWeight": 550,
      "lineHeight": 1.32,
      "align": "left",
      "appearance": "code"
    },
    {
      "id": "N01",
      "type": "narration",
      "speaker": null,
      "text": "yield 交出一个值并暂停；下一次 next() 才继续。",
      "direction": "horizontal",
      "x": 64,
      "y": 638,
      "width": 534,
      "height": 66,
      "padding": 13,
      "fontFamily": "PingFang SC",
      "fontSize": 19,
      "minFontSize": 16,
      "fontWeight": 600,
      "lineHeight": 1.25,
      "align": "center",
      "appearance": "card"
    },
    {
      "id": "N02",
      "type": "narration",
      "speaker": null,
      "text": "循环体完成后，才会请求下一项。",
      "direction": "horizontal",
      "x": 642,
      "y": 638,
      "width": 534,
      "height": 66,
      "padding": 13,
      "fontFamily": "PingFang SC",
      "fontSize": 19,
      "minFontSize": 16,
      "fontWeight": 600,
      "lineHeight": 1.25,
      "align": "center",
      "appearance": "card"
    },
    {
      "id": "S03",
      "type": "technical",
      "speaker": null,
      "text": "一次事件怎样越过两端",
      "direction": "horizontal",
      "x": 64,
      "y": 724,
      "width": 1112,
      "height": 54,
      "padding": 11,
      "fontFamily": "PingFang SC",
      "fontSize": 24,
      "minFontSize": 20,
      "fontWeight": 700,
      "lineHeight": 1.2,
      "align": "center",
      "appearance": "inverted"
    },
    {
      "id": "F01",
      "type": "technical",
      "speaker": null,
      "text": "① 消费端调用 iterator.next()\n② 生成器运行到下一次 yield\n③ yield 交出事件，并暂停生产端\n④ 消费端取得事件，await render(event)\n⑤ 循环体结束，再请求 iterator.next()",
      "direction": "horizontal",
      "x": 64,
      "y": 794,
      "width": 534,
      "height": 300,
      "padding": 24,
      "fontFamily": "PingFang SC",
      "fontSize": 21,
      "minFontSize": 17,
      "fontWeight": 600,
      "lineHeight": 1.8,
      "align": "left",
      "appearance": "card"
    },
    {
      "id": "F02",
      "type": "technical",
      "speaker": null,
      "text": "for await 隐藏的动作（近似）\n\nconst { value, done } = await iterator.next();\nif (done) break;\nawait render(value);",
      "direction": "horizontal",
      "x": 642,
      "y": 794,
      "width": 534,
      "height": 300,
      "padding": 24,
      "fontFamily": "SFMono-Regular",
      "fontSize": 18,
      "minFontSize": 16,
      "fontWeight": 550,
      "lineHeight": 1.48,
      "align": "left",
      "appearance": "code"
    },
    {
      "id": "S04",
      "type": "technical",
      "speaker": null,
      "text": "等待处理，不等于按需生产",
      "direction": "horizontal",
      "x": 64,
      "y": 1126,
      "width": 1112,
      "height": 52,
      "padding": 10,
      "fontFamily": "PingFang SC",
      "fontSize": 24,
      "minFontSize": 20,
      "fontWeight": 700,
      "lineHeight": 1.2,
      "align": "center",
      "appearance": "inverted"
    },
    {
      "id": "C03",
      "type": "technical",
      "speaker": null,
      "text": "普通 for + await\nfor (const event of existingEvents) {\n  await handle(event);\n}",
      "direction": "horizontal",
      "x": 64,
      "y": 1194,
      "width": 534,
      "height": 120,
      "padding": 18,
      "fontFamily": "SFMono-Regular",
      "fontSize": 18,
      "minFontSize": 16,
      "fontWeight": 550,
      "lineHeight": 1.15,
      "align": "left",
      "appearance": "code"
    },
    {
      "id": "C04",
      "type": "technical",
      "speaker": null,
      "text": "for await...of\nfor await (const event of asyncSource) {\n  await handle(event);\n}",
      "direction": "horizontal",
      "x": 642,
      "y": 1194,
      "width": 534,
      "height": 120,
      "padding": 18,
      "fontFamily": "SFMono-Regular",
      "fontSize": 18,
      "minFontSize": 16,
      "fontWeight": 550,
      "lineHeight": 1.15,
      "align": "left",
      "appearance": "code"
    },
    {
      "id": "N03",
      "type": "narration",
      "speaker": null,
      "text": "数据通常已经存在；await 只保证串行处理。",
      "direction": "horizontal",
      "x": 64,
      "y": 1322,
      "width": 534,
      "height": 52,
      "padding": 11,
      "fontFamily": "PingFang SC",
      "fontSize": 18,
      "minFontSize": 16,
      "fontWeight": 600,
      "lineHeight": 1.25,
      "align": "center",
      "appearance": "card"
    },
    {
      "id": "N04",
      "type": "narration",
      "speaker": null,
      "text": "消费端不请求 next()，按需生产者就停在 yield。",
      "direction": "horizontal",
      "x": 642,
      "y": 1322,
      "width": 534,
      "height": 52,
      "padding": 11,
      "fontFamily": "PingFang SC",
