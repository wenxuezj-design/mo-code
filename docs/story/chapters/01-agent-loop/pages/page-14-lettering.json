    },
    {
      "id": "S02",
      "type": "technical",
      "speaker": null,
      "text": "消费端 · for await...of",
      "direction": "horizontal",
      "x": 642,
      "y": 400,
      "width": 534,
      "height": 46,
      "padding": 10,
      "fontFamily": "SFMono-Regular",
