      "text": "教学伪代码（只表达两级恢复顺序）\nif (response.stopReason === \"max_tokens\") {\n  if (!outputLimitEscalated) {\n    maxTokens = higherLimit;\n    outputLimitEscalated = true;\n    continue; // max_output_tokens_escalate\n  }\n  if (continuationCount < MAX_CONTINUATIONS) {\n    appendContinuationPrompt();\n    continuationCount++;\n    continue; // max_output_tokens_recovery\n  }\n  throw new OutputStillIncompleteError();\n}",
